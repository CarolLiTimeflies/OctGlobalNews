</div>
<script>
var sigs = {"s1": {"id": "s1", "label": "dominant", "color": "#B0855A", "title": "AI 从“试点”进入生产与合规双轨", "desc": "本月 97% 的欧美工作室负责人承认在开发中使用 AI，94% 已覆盖九个制作阶段中的多个环节，采用率不再构成差异化。真正的分水岭出现在治理侧：Capcom 把 AI 嵌进自研 RE Engine 的 QA、调试与数据处理；Epic 推迟迪士尼题材新作的同时要求团队“AI 优先”；UKIE 与 Sheridans 推出四步认证流程，给出可在路演中展示的合规标识。与之并行的是反作用力——Epic CEO 称 Steam 的 AI 披露政策是“政治行为”，Jagex 因外包方使用生成式 AI 下架宣传物料，Sega 明确不把创作环节交给 AI。", "why": "AI 的边际收益已经从“能不能用”转向“能不能证明怎么用”。当合规凭证进入融资与发行谈判，工具能力让位于流程透明度与责任归属，采购决策会从创意团队上移到法务与财务。", "strategic": "把 AI 治理当作可交付资产来建设：模型来源、训练数据授权、外包环节披露、生成内容审核四条链路各自留痕，才能在发行与融资场景中把合规变成加速项而非阻塞项。", "industry_significance": "合规基础设施的成型速度正在快于内容创新本身。这会带来一个结构性后果：拥有法务与流程能力的中大型厂商将获得不对称优势，而依赖外部合作方的小团队需要共担风险。", "articles": [{"title": "Capcom 用 AI 强化自研 RE Engine，长期剑指“AI 生成式引擎”", "url": "https://www.gamesindustry.biz/capcom-aims-to-enhance-its-propriety-re-engine-with-ai-to-accelerate-efficiency-in-qa-debugging-and-data-processing"}, {"title": "Vivrato：欧美 97% 工作室负责人在开发中使用 AI", "url": "https://www.gamesindustry.biz/vivrato-97-of-studio-leaders-use-ai-in-some-form-during-development-in-eu-and-north-america"}, {"title": "Epic 推迟迪士尼题材新作并要求团队“AI 优先”", "url": "https://www.gamesindustry.biz/epic-games-delays-disney-game-and-tells-developers-to-go-ai-first"}, {"title": "UKIE 与 Sheridans 合作推出 AI 合规与认证服务", "url": "https://www.gamesindustry.biz/ukie-partners-with-sheridans-on-ai-compliance-and-accreditation-service-to-guide-uk-studios-in-using-ai-lawfully-and-responsibly"}, {"title": "AI 现状盘点：AI 法规如何影响游戏开发", "url": "https://www.gamesindustry.biz/the-ai-state-of-play-ai-laws-and-game-development"}, {"title": "Epic CEO 称 Steam 的 AI 披露政策是“政治行为”", "url": "https://www.gamesindustry.biz/epic-games-ceo-calls-steams-ai-disclosure-policies-a-political-act"}]}, "s2": {"id": "s2", "label": "recurring", "color": "#5A7A91", "title": "组织收缩进入第二轮：从项目裁撤到招牌工作室清盘", "desc": "10 月同时出现三种收缩形态：BioWare 在成立 30 年后关闭、EA 裁撤约 400 个岗位；育碧关闭《Trials》开发商 RedLynx 并裁减新加坡 70 个岗位、在德国三地推行约 100 人的自愿离职；Microsoft 向最多 6 万名员工开放自愿离职，Xbox 员工在列。中型团队同样承压——Auroch Digital 裁掉四分之一，Fishlabs 因项目需求变化裁员，Sucker Punch 在《Ghost of Yōtei》完整版发售后裁撤 24 人。", "why": "裁员的逻辑从“砍掉失败项目”转向“在成功之后立刻调整编制”，说明成本结构问题不在单个产品，而在固定人力与不可预测收入的匹配方式。自愿离职与买断成为首选工具，是为了在保留关键岗位的同时压低舆论与法律成本。", "strategic": "把编制变成可伸缩结构：核心团队保留判断力与工具链所有权，边缘产能用合同制与合作开发承接。剥离后转向员工持股的 Undead Labs 与采用分布式开发的 Fuse Games 提供了两种可参照的模板。", "industry_significance": "收缩正在重塑人才流向。AAA 老兵转向独立的动因不是机会更多，而是可预期性更强，这会持续抽走大厂的中层制作能力。", "articles": [{"title": "BioWare 在成立 30 年后关闭，EA 裁撤约 400 个岗位", "url": "https://www.gamesindustry.biz/bioware-is-closing-after-30-years"}, {"title": "育碧关闭《Trials》开发商 RedLynx 并裁减新加坡团队", "url": "https://www.gamesindustry.biz/ubisoft-closing-trials-developer-redlynx-and-cutting-jobs-in-singapore-studio"}, {"title": "Xbox 员工在 Microsoft 最多 6 万人的自愿离职计划范围内", "url": "https://www.gamesindustry.biz/xbox-staff-among-up-to-60000-microsoft-employees-offered-voluntary-exit"}, {"title": "Sucker Punch 据报在《Ghost of Yōtei》完整版发售后裁撤 24 人", "url": "https://www.gamesindustry.biz/sucker-punch-productions-reportedly-lays-off-24-employees-following-launch-of-ghost-of-yotei-complete-edition"}, {"title": "Auroch Digital 裁减四分之一员工", "url": "https://www.gamesindustry.biz/auroch-digital-lays-off-a-quarter-of-its-staff"}, {"title": "Fishlabs 因“项目需求变化”裁员，开发与支持团队受影响", "url": "https://www.gamesindustry.biz/fishlabs-announces-layoffs-due-to-changing-project-requirements-development-and-support-teams-affected"}, {"title": "Funcom 裁员并将业务收缩至《Conan Exiles》与《Dune: Awakening》", "url": "https://www.gamesindustry.biz/funcom-to-lay-off-staff-as-it-pivots-to-focusing-solely-on-conan-exiles-and-dune-awakening"}, {"title": "Ninja Theory 开始裁员", "url": "https://www.gamesindustry.biz/ninja-theory-begins-laying-off-staff-according-to-employee-posts"}]}, "s3": {"id": "s3", "label": "recurring", "color": "#5A7A91", "title": "资本向头部资产与跨媒介 IP 双重集中", "desc": "Aream & Co 统计三季度游戏业并购规模达 578 亿美元，其中 EA 的 550 亿美元杠杆收购占绝大多数；Paramount 与 Warner Bros. Discovery 在 Skydance 主导下完成 1110 亿美元合并，两家发行商的游戏部门随即合为一体。IP 侧的资本动作同样密集：Xbox 成立 XP 部门专做影视与主题公园衍生，Netflix 据报出价 5 亿美元求购 Xbox IP 七年授权（被要求 8 亿美元后搁置），Paramount 与 CDPR 联合制作《Cyberpunk 2077》真人电影，Griffin Gaming 与 Entertainment 360 合资成立 HITpoint 专门承接改编。", "why": "并购与授权同时升温，说明头部 IP 的变现路径已从“卖游戏”扩展为“管理跨媒介现金流”。当授权成为可定价资产，IP 拥有方的估值基准会脱离单一产品的销量周期。", "strategic": "先想清楚 IP 的授权边界再谈产品排期：哪些世界观可以并行开发、哪些必须由自有团队掌控、授权期限与地域如何切分，这些条款的谈判价值正在超过单款产品的发行窗口。", "industry_significance": "中型发行商的选择空间被压缩——要么成为头部 IP 的执行方，要么靠原创 IP 在细分品类建立不可替代性，中间路线正在消失。", "articles": [{"title": "Aream & Co：三季度游戏业并购规模达 578 亿美元", "url": "https://www.gamesindustry.biz/aream-co-games-industry-ma-generates-578-bn-in-q3-including-eas-55bn-leveraged-buyout"}, {"title": "Paramount Games Studio 与 WB Games 在 Skydance 旗下合并", "url": "https://www.gamesindustry.biz/paramount-games-studio-and-wb-games-merge-under-skydance-following-completion-of-111bn-acquisition"}, {"title": "Xbox 成立 XP 部门，专做影视与主题公园等跨媒介衍生", "url": "https://www.gamesindustry.biz/xbox-announces-new-xp-division-to-deliver-transmedia-spinoffs-including-film-tv-and-theme-parks"}, {"title": "Netflix 据报出价 5 亿美元向 Microsoft 求购 Xbox IP 七年授权", "url": "https://www.gamesindustry.biz/netflix-reportedly-offered-500m-to-microsoft-to-license-xbox-ip-for-seven-years"}, {"title": "Paramount 将拍《Cyberpunk 2077》世界观真人电影，CDPR 联合制片", "url": "https://www.gamesindustry.biz/paramount-pictures-adapting-live-action-movie-set-in-cyberpunk-2077-universe-co-produced-by-cd-projekt-red"}, {"title": "Griffin Gaming Partners 与 Entertainment 360 成立 HITpoint 推动游戏影视化", "url": "https://www.gamesindustry.biz/griffin-gaming-partners-and-entertainment-360-launch-new-company-to-support-video-game-adaptations-for-film-and-tv"}, {"title": "Bungie 联合创始人与《命运2》叙事总监创办跨媒介工作室 Stone Kite", "url": "https://www.gamesindustry.biz/bungie-co-founder-and-destiny-2-narrative-director-launch-transmedia-studio-stone-kite"}]}, "s4": {"id": "s4", "label": "recurring", "color": "#5A7A91", "title": "平台规则重写：分成、披露与定价同时松动的三方博弈", "desc": "Google Play 推出 Game Finder 等发现机制，并向表现突出的作品提供更低服务费；Xbox 把云游戏拆成分层定价，起步 3.99 美元；澳洲联邦法院认定 Apple 限制第三方商店与支付方式违反竞争法，《Fortnite》得以重返 iOS。规则争议同时来自内容侧：Epic CEO 抨击 Steam 的 AI 披露政策，PEGI 把含开箱的既有数字游戏上调至 16 评级，Legacy Games 关闭商店导致已购内容无法重新下载。英国方向，UKIE 呼吁在秋季预算前改革游戏支出抵免。", "why": "平台方开始用分成让利与发现机制争夺优质内容，同时把成本向用户侧转移（云串流按时长计价）。监管在单一市场打开缺口，但区域判决的全球外溢有限，发行策略需要按辖区分别建模。", "strategic": "把平台条款当作产品变量而非背景条件：分成阶梯、AI 披露、云串流限额、区域合规评级都应进入发行测算模型，否则单一辖区的规则变化会直接吞掉利润假设。", "industry_significance": "内容方与平台的议价关系正在从“流量换分成”转为“合规与独家性换条件”，谁能提供可验证的差异化内容，谁就能拿到非标准条款。", "articles": [{"title": "Google Play 推出 Game Finder、Sprints 与 Sidekick Playbacks", "url": "https://www.gamesindustry.biz/google-play-adds-game-finder-sprints-and-sidekick-playbacks-in-discovery-push"}, {"title": "Xbox 公布云游戏分层定价，起步价 3.99 美元", "url": "https://www.gamesindustry.biz/xbox-reveals-pricing-for-cloud-gaming-limits-starting-at-399-for-10-hours"}, {"title": "澳洲法院认定 Apple 违反竞争法，《Fortnite》重返 iOS", "url": "https://www.gamesindustry.biz/fortnite-returns-to-ios-in-australia-after-court-rules-apple-violated-competition-law"}, {"title": "Epic CEO 称 Steam 的 AI 披露政策是“政治行为”", "url": "https://www.gamesindustry.biz/epic-games-ceo-calls-steams-ai-disclosure-policies-a-political-act"}, {"title": "PEGI 将含开箱的既有数字游戏评级上调至 16", "url": "https://www.gamesindustry.biz/pegi-begins-moving-existing-digital-only-games-with-loot-boxes-up-to-a-16-rating"}, {"title": "休闲游戏平台 Legacy Games 将于 12 月关闭在线商店", "url": "https://www.gamesindustry.biz/casual-game-marketplace-legacy-games-to-close-online-store-this-december"}, {"title": "UKIE 呼吁在秋季预算前改革游戏支出抵免政策", "url": "https://www.gamesindustry.biz/ukie-calls-on-government-to-modernise-video-games-expenditure-credit-ahead-of-autumn-budget"}]}, "s5": {"id": "s5", "label": "emerging", "color": "#7A9E7D", "title": "独立游戏与原创 IP 的突破：新品也能赢得规模化市场", "desc": "首月销量超过 50 万份的作品中过半是新系列的开端，原创 IP 的商业上限被重新确认。支撑这一结果的是生产方式的调整：《Valheim》《Hades》《Phasmophobia》等团队把早期访问当作正式发售来运营；Fuse Games 用分布式开发维持小核心团队；《DayZ》作者 Dean Hall 发布开源框架 Brutal，直言 Unity 与 Unreal“没有对创作者承担责任”；GameMaker 宣布新一代运行时 2027 年起免费商用。PlayStation 之父久夲良木健则从反面给出判断——数千人做数年“几乎不可能持续”。", "why": "当 3A 的生产成本逼近不可持续，效率不再来自单点工具，而来自对研发节奏与团队规模的重新设计。早期访问把市场验证前置，开源与免费工具把固定成本转成可变成本。", "strategic": "为每个项目预设一个“一月判断点”：在有限投入内验证核心循环是否成立，再决定加码或放弃。Landfall 的做法是把这条规则制度化，而不是靠感觉止损。", "industry_significance": "原创 IP 的爆发与工具成本下降是同一条曲线的两端。中型团队第一次可以在不依赖大额融资的前提下，同时承担创意风险与技术选型风险。", "articles": [{"title": "2026 年独立游戏与原创 IP 全面爆发", "url": "https://www.gamesindustry.biz/indies-and-original-ip-blew-up-in-2026"}, {"title": "早期访问专题：开发者必须把 EA 当作正式发售对待", "url": "https://www.gamesindustry.biz/developers-need-to-treat-early-access-like-a-real-launch-because-players-do-early-access-games-are-on-the-rise-but-so-are-player-expectations"}, {"title": "《DayZ》作者 Dean Hall 发布开源开发框架 Brutal", "url": "https://www.gamesindustry.biz/dayz-creator-dean-hall-releases-open-source-game-development-framework-brutal"}, {"title": "GameMaker 宣布新一代运行时 GMRT 于 2027 年 1 月起免费商用", "url": "https://www.gamesindustry.biz/gamemaker-to-make-its-next-generation-runtime-gmrt-free-for-commercial-use-in-january-2027"}, {"title": "《Star Wars: Galactic Racer》如何用“分布式开发”保持小核心团队", "url": "https://www.gamesindustry.biz/how-star-wars-galactic-racer-kept-the-core-team-small-and-sustainable-through-distributed-development"}, {"title": "播客：Landfall 的 Rebecca Lautner 谈《Peak》2300 万销量", "url": "https://www.gamesindustry.biz/podcast-landfalls-rebecca-lautner-on-peaks-23-million-sales-and-looking-past-friendslop"}, {"title": "PlayStation 之父久夛良木健谈当下游戏业", "url": "https://www.gamesindustry.biz/taking-several-years-with-several-thousand-people-its-almost-impossible-playstation-creator-ken-kutaragi-on-the-current-state-of-gaming"}]}};
var evts = {"e1": {"id": "e1", "date": "10月7日", "title": "Paramount 与 WBD 完成 1110 亿美元合并，游戏部门并入 Skydance", "brief": "交易完成后，Paramount Games Studio 与 WB Games 合并为同一游戏部门，由 Paramount Game Studio 总裁 Tony Driscoll 领导。CEO David Ellison 在交易完成前即警告将带来“艰难决定”与人员影响。合并把两家发行商的游戏资产、IP 库与发行渠道收进同一条决策链，跨界内容集团的游戏业务第一次具备与影视同级的组织地位。", "impact": "整合期的第一波动作通常不是扩张而是裁撤重叠职能，短期内可能看到项目取消与人员调整。对外部合作方而言，决策权集中意味着谈判对手变少但单笔合同变大。", "strategic": "与这类新集团合作时，应尽早确认游戏业务的预算归属与决策链长度，避免把资源押在整合期会被重估的中层项目上。", "url": "https://www.gamesindustry.biz/paramount-games-studio-and-wb-games-merge-under-skydance-following-completion-of-111bn-acquisition", "ss": [{"id": "s3", "color": "#5A7A91", "title": "资本向头部资产与跨媒介 IP 双重集中"}], "articles": [{"title": "Paramount Games Studio 与 WB Games 在 Skydance 旗下合并", "url": "https://www.gamesindustry.biz/paramount-games-studio-and-wb-games-merge-under-skydance-following-completion-of-111bn-acquisition"}, {"title": "Paramount 与 Warner Bros. Discovery 在 Skydance 主导下完成 1110 亿美元合并", "url": "https://www.gamesindustry.biz/paramount-and-warner-bros-discovery-operating-under-skydance-following-completion-of-111bn-merger"}, {"title": "合并后的 Skydance 要求每周五天到岗并提供自愿买断", "url": "https://www.gamesindustry.biz/newly-merged-skydance-mandates-staff-return-to-office-five-days-a-week-offers-voluntary-buyout-program"}]}, "e2": {"id": "e2", "date": "10月21日", "title": "BioWare 在成立 30 年后关闭，EA 裁撤约 400 个岗位", "brief": "EA 确认裁撤约 400 个岗位，其中约 50 个位于 BioWare，这家成立于 1995 年的叙事 RPG 工作室就此终止。同期逾 22.3 万人联署请愿要求 EA“采取果断行动”保住 Mass Effect 系列。事件的核心不是单个工作室的失败，而是高成本单机叙事 RPG 的生产模式在现行收入结构下被判定为不可持续。", "impact": "老牌叙事 IP 将进入“授权与外包”阶段，而非由原团队续作。玩家情绪转化为对发行商 IP 处置的公开施压，品牌资产管理与社区沟通的成本随之上升。", "strategic": "高成本叙事型项目的立项需要绑定可验证的收入结构——订阅、跨媒介授权或长短线组合，仅靠单次买断销量支撑的数年研发周期已难通过财务审查。", "url": "https://www.gamesindustry.biz/bioware-is-closing-after-30-years", "ss": [{"id": "s2", "color": "#5A7A91", "title": "组织收缩进入第二轮：从项目裁撤到招牌工作室清盘"}], "articles": [{"title": "BioWare 在成立 30 年后关闭，EA 裁撤约 400 个岗位", "url": "https://www.gamesindustry.biz/bioware-is-closing-after-30-years"}, {"title": "逾 22.3 万人联署“拯救 Mass Effect”", "url": "https://www.gamesindustry.biz/223000-people-sign-petition-to-save-mass-effect"}, {"title": "Microsoft 延长 Arkane Lyon 的协商期，《Marvel's Blade》继续开发", "url": "https://www.gamesindustry.biz/microsoft-extends-consultation-period-for-arkane-lyon-as-it-continues-development-on-marvels-blade"}]}, "e3": {"id": "e3", "date": "10月22日", "title": "澳洲法院认定 Apple 违反竞争法，《Fortnite》重返 iOS", "brief": "澳大利亚联邦法院裁定 Apple 限制第三方应用商店与支付方式以削弱竞争，违反该国竞争法，《Fortnite》据此重返 iOS。这是 Epic 在全球多条战线中少见的实体胜利，但判决的效力限于单一辖区，其他市场的应用商店规则并未同步改变。", "impact": "区域判决为发行策略提供了“按辖区分化”的现实样本：同一产品在不同市场的支付通道、分成比例与上架条件可以完全不同，全球统一发行的假设失效。", "strategic": "把辖区合规差异做成配置项而非例外处理：支付通道、商店条款、评级要求都应可在发行配置层独立开关，避免为单一市场重做产品。", "url": "https://www.gamesindustry.biz/fortnite-returns-to-ios-in-australia-after-court-rules-apple-violated-competition-law", "ss": [{"id": "s4", "color": "#5A7A91", "title": "平台规则重写：分成、披露与定价同时松动的三方博弈"}], "articles": [{"title": "澳洲法院认定 Apple 违反竞争法，《Fortnite》重返 iOS", "url": "https://www.gamesindustry.biz/fortnite-returns-to-ios-in-australia-after-court-rules-apple-violated-competition-law"}, {"title": "Epic CEO 称 Steam 的 AI 披露政策是“政治行为”", "url": "https://www.gamesindustry.biz/epic-games-ceo-calls-steams-ai-disclosure-policies-a-political-act"}, {"title": "Google Play 推出 Game Finder、Sprints 与 Sidekick Playbacks", "url": "https://www.gamesindustry.biz/google-play-adds-game-finder-sprints-and-sidekick-playbacks-in-discovery-push"}]}, "e4": {"id": "e4", "date": "10月26日", "title": "Netflix 据报 5 亿美元求购 Xbox IP 七年授权遭拒", "brief": "有报道称 Netflix 向 Microsoft 提出 5 亿美元、七年期的 Xbox IP 授权方案，Xbox 方面在要求 8 亿美元后拒绝。同期 Xbox 成立 XP 部门专做影视与主题公园衍生，Paramount 与 CDPR 联合制作《Cyberpunk 2077》真人电影。IP 授权从零星交易变成有明确报价区间的资产类别。", "impact": "授权定价开始具备可比参照，IP 拥有方在谈判中拥有了估值锚点；流媒体平台为填补内容缺口愿意支付长期溢价，但期限越长，拥有方对世界观控制权的让渡越需要谨慎设计。", "strategic": "为自有 IP 建立分级授权框架：哪些世界观可整体授权、哪些只授权衍生叙事、期限与地域如何切分。谈判前先确定不可让渡的创作控制项，避免长期合同锁死后续自研空间。", "url": "https://www.gamesindustry.biz/netflix-reportedly-offered-500m-to-microsoft-to-license-xbox-ip-for-seven-years", "ss": [{"id": "s3", "color": "#5A7A91", "title": "资本向头部资产与跨媒介 IP 双重集中"}], "articles": [{"title": "Netflix 据报出价 5 亿美元向 Microsoft 求购 Xbox IP 七年授权", "url": "https://www.gamesindustry.biz/netflix-reportedly-offered-500m-to-microsoft-to-license-xbox-ip-for-seven-years"}, {"title": "Xbox 成立 XP 部门，专做影视与主题公园等跨媒介衍生", "url": "https://www.gamesindustry.biz/xbox-announces-new-xp-division-to-deliver-transmedia-spinoffs-including-film-tv-and-theme-parks"}, {"title": "Paramount 将拍《Cyberpunk 2077》世界观真人电影，CDPR 联合制片", "url": "https://www.gamesindustry.biz/paramount-pictures-adapting-live-action-movie-set-in-cyberpunk-2077-universe-co-produced-by-cd-projekt-red"}, {"title": "Griffin Gaming Partners 与 Entertainment 360 成立 HITpoint 推动游戏影视化", "url": "https://www.gamesindustry.biz/griffin-gaming-partners-and-entertainment-360-launch-new-company-to-support-video-game-adaptations-for-film-and-tv"}]}, "e5": {"id": "e5", "date": "10月29日", "title": "Capcom 上半财年数字内容收入增 70.8%，Xbox 硬件季度下滑 14%", "brief": "Capcom 上半财年数字内容部门收入大涨 70.8% 至 5.384 亿美元，由《Onimusha》《Resident Evil》《Pragmata》《Monster Hunter》多 IP 组合拉动；同日 Microsoft 财报显示 Xbox 第一方内容部分抵消了总收入 2% 的下滑，但硬件收入下降 14%。两条曲线指向同一件事：内容供给的确定性正在替代硬件装机量成为收入主轴。", "impact": "多 IP 组合让 Capcom 在单作波动中保持增长，而平台方在硬件收缩时更依赖第一方内容与订阅。硬件周期与内容周期的脱钩会改变平台对第三方的依赖方式。", "strategic": "把产品组合当作风险对冲工具而非排期结果：不同 IP 的上线节奏应有意识地错开财务季度，用组合稳定性换取单作的研发自由度。", "url": "https://www.gamesindustry.biz/onimusha-resident-evil-pragmata-and-monster-hunter-franchises-boost-capcom-h1-results", "ss": [{"id": "s2", "color": "#5A7A91", "title": "组织收缩进入第二轮：从项目裁撤到招牌工作室清盘"}, {"id": "s3", "color": "#5A7A91", "title": "资本向头部资产与跨媒介 IP 双重集中"}], "articles": [{"title": "《Onimusha》《Resident Evil》《Pragmata》《Monster Hunter》拉动 Capcom 上半财年业绩", "url": "https://www.gamesindustry.biz/onimusha-resident-evil-pragmata-and-monster-hunter-franchises-boost-capcom-h1-results"}, {"title": "Xbox 第一方内容部分抵消 Q1 收入 2% 下滑，硬件下降 14%", "url": "https://www.gamesindustry.biz/xbox-first-party-content-partially-offsets-2-drop-in-q1-revenue-hardware-decreases-14"}, {"title": "《Marvel's Wolverine》登顶美国 9 月榜，创 Sony 发行作品新纪录", "url": "https://www.gamesindustry.biz/marvels-wolverine-leads-us-september-charts-achieves-highest-monthly-dollar-sales-for-a-sony-published-title-since-helldivers-2"}, {"title": "《Wardogs》领跑 Newzoo 9 月 PC 收入榜", "url": "https://www.gamesindustry.biz/wardogs-leads-newzoos-september-pc-revenue-charts"}]}};

// === SCROLL NAVIGATION ===
function scrollToSection(sectionId) {
  var el = document.getElementById(sectionId);
  if (el) {
    el.scrollIntoView({ behavior: 'smooth', block: 'start' });
  }
}

function goResearch(id){switchTab('newzoo');requestAnimationFrame(function(){document.getElementById(id).scrollIntoView({behavior:'smooth',block:'start'});});}
// === TAB SWITCHING ===
function switchTab(tabId) {
  document.querySelectorAll('.tab-btn').forEach(function(t) {
    t.classList.remove('active');
  });
  document.querySelectorAll('.tab-btn[data-tab="' + tabId + '"]').forEach(function(t) {
    t.classList.add('active');
  });
  document.querySelectorAll('.panel').forEach(function(p) {
    p.style.display = 'none';
    p.classList.remove('active');
  });
  var target = document.getElementById(tabId === 'summary' ? 'summary-panel' : tabId);
  if (target) {
    target.style.display = 'block';
    target.classList.add('active');
    window.scrollTo(0, 0);
  }
}

// === WEEK FILTERING ===
function filterWeek(weekId, cat) {
  var panel = document.getElementById(weekId);
  if (!panel) return;
  var cards = panel.querySelectorAll('.article-card');
  cards.forEach(function(c) {
    if (cat === 'all' || c.dataset.cat === cat) {
      c.style.display = 'block';
    } else {
      c.style.display = 'none';
    }
  });
  var chips = panel.querySelectorAll('.fchip');
  chips.forEach(function(f) {
    f.classList.toggle('active', f.dataset.filter === cat);
  });
}

function applyFilter(weekId, filterId) {
  filterWeek(weekId, filterId);
}

// === DRAWER: OPEN ===
function openDrawer(type, id) {
  var overlay = document.getElementById('drawer-overlay');
  var panel = document.getElementById('drawer-panel');
  var content = document.getElementById('drawer-content');
  if (!content) return;
  if (type === 'sig' && sigs[id]) {
    content.innerHTML = buildSignalDrawer(sigs[id]);
  } else if (type === 'evt' && evts[id]) {
    content.innerHTML = buildEventDrawer(evts[id]);
  }
  overlay.classList.add('active');
  panel.classList.add('active');
  document.body.style.overflow = 'hidden';
}

// === DRAWER: BUILD SIGNAL CONTENT ===
function buildSignalDrawer(s) {
  var html = '<div class="drawer-header">' +
    '<div><span class="badge" style="background:' +
    (s.label === 'dominant' ? 'var(--accent-warm)' : s.label === 'recurring' ? 'var(--accent-blue)' : 'var(--accent-sage)') +
    ';color:#fff">' +
    (s.label === 'dominant' ? '主导趋势' : s.label === 'recurring' ? '持续趋势' : '新兴趋势') +
    '</span><h3 style="margin-top:8px">' + s.title + '</h3></div>' +
    '<button class="drawer-close" onclick="closeDrawer()">✕</button></div>';
  html += '<div class="drawer-section"><div class="ds-label">详细分析</div><div class="ds-content">' + s.desc + '</div></div>';
  html += '<div class="drawer-section"><div class="ds-label">行业启发</div><div class="ds-content">' + s.why + '</div></div>';
  if (s.strategic) {
    html += '<div class="drawer-section"><div class="ds-label">战略启示</div><div class="ds-content">' + s.strategic + '</div></div>';
  }
  if (s.industry_significance) {
    html += '<div class="drawer-section"><div class="ds-label">行业意义</div><div class="ds-content">' + s.industry_significance + '</div></div>';
  }
  if (s.articles && s.articles.length > 0) {
    html += '<div class="drawer-section"><div class="ds-label">相关文章</div>';
    s.articles.forEach(function(a) {
      html += '<div style="margin-top:8px"><a href="' + a.url + '" target="_blank" rel="noopener noreferrer" style="color:var(--accent-blue);text-decoration:none;font-size:14px">' + a.title + '</a></div>';
    });
    html += '</div>';
  }
  return html;
}

// === DRAWER: BUILD EVENT CONTENT ===
function buildEventDrawer(e) {
  var html = '<div class="drawer-header">' +
    '<div><span class="badge" style="background:var(--accent-lavender);color:#fff">' + e.date + '</span>' +
    '<h3 style="margin-top:8px">' + e.title + '</h3></div>' +
    '<button class="drawer-close" onclick="closeDrawer()">✕</button></div>';
  html += '<div class="drawer-section"><div class="ds-label">详细分析</div><div class="ds-content">' + e.brief + '</div></div>';
  html += '<div class="drawer-section"><div class="ds-label">行业启发</div><div class="ds-content">' + e.impact + '</div></div>';
  if (e.strategic) {
    html += '<div class="drawer-section"><div class="ds-label">战略启示</div><div class="ds-content">' + e.strategic + '</div></div>';
  }
  if (e.url) {
    html += '<div class="drawer-section"><div class="ds-label">原文链接</div>';
    html += '<div style="margin-top:8px"><a href="' + e.url + '" target="_blank" rel="noopener noreferrer" style="color:var(--accent-blue);text-decoration:none;font-size:14px">查看原文</a></div>';
    html += '</div>';
  }
  if (e.articles && e.articles.length > 0) {
    html += '<div class="drawer-section"><div class="ds-label">相关文章</div>';
    e.articles.forEach(function(a) {
      html += '<div style="margin-top:8px"><a href="' + a.url + '" target="_blank" rel="noopener noreferrer" style="color:var(--accent-blue);text-decoration:none;font-size:14px">' + a.title + '</a></div>';
    });
    html += '</div>';
  }
  if (e.ss) {
    html += '<div class="drawer-section"><div class="ds-label">关联信号</div>';
    e.ss.forEach(function(s) {
      html += '<div class="related-signal" data-sigid="' + (s.id || '').replace(/"/g, '&quot;') + '" style="margin-top:6px;padding:8px 12px;background:var(--bg-secondary);border-radius:8px;cursor:pointer">' +
        '<span style="display:inline-block;width:8px;height:8px;border-radius:50%;background:' + (s.color || 'var(--accent-blue)') + ';margin-right:6px"></span>' +
        s.title + '</div>';
    });
    html += '</div>';
  }
  return html;
}

// === DRAWER: CLOSE ===
function closeDrawer() {
  document.getElementById('drawer-overlay').classList.remove('active');
  document.getElementById('drawer-panel').classList.remove('active');
  document.body.style.overflow = '';
}

// === KEYBOARD SHORTCUTS ===
document.addEventListener('keydown', function(e) {
  if (e.key === 'Escape') closeDrawer();
  if (e.key === '0' || e.key === '`' || e.key === '~') switchTab('summary');
  if (e.key >= '1' && e.key <= '5') switchTab('week' + e.key);
});

// === EVENT DELEGATION: Related Signal clicks inside Drawer ===
document.addEventListener('click', function(e) {
  var rel = e.target.closest('.related-signal');
  if (rel && rel.dataset && rel.dataset.sigid) {
    closeDrawer();
    setTimeout(function() { openDrawer('sig', rel.dataset.sigid); }, 350);
  }
});

// === INIT ===
document.addEventListener('DOMContentLoaded', function() {
  switchTab('summary');
});

</script>
</body>
</html>
